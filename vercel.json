{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin/logs",
      "destination": "/admin-logs.html"
    },
    {
      "source": "/admin/fluxo-principal",
      "destination": "/flow-map.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "env": {
    "UTALK_API_BASE": "https://app-utalk.umbler.com/api"
  }
}
